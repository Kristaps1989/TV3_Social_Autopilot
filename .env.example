# --- Core ---
# true = full pipeline runs but nothing is posted to real platforms (Phase 1 default)
DRY_RUN=true
DATABASE_URL=sqlite:///data/autopilot.db
# For production: postgresql+psycopg2://autopilot:password@postgres:5432/autopilot
TZ=Europe/Riga

# --- Persistence on ephemeral hosts (Railway etc.) ---
# Mount a persistent volume at /srv/autopilot/data and point the editable
# config dirs into it; they are seeded from the repo defaults on first start.
# Without this, every redeploy wipes the DB, tokens, and rule edits.
# RULES_DIR=/srv/autopilot/data/rules
# PROMPTS_DIR=/srv/autopilot/data/prompts

# --- AI decision layer ---
# If unset, the service still runs: a deterministic fallback scores and formats posts.
ANTHROPIC_API_KEY=
# FAST: parastie raksti (Sonnet 5 — laba latviešu gramatika par ~$0.02/lēmums).
# STRONG: now/must raksti, kopsavilkumi (Opus 5). Fable 5.1 te NEDER —
# lēmums lieto piespiedu tool_choice, ko tas noraida.
AI_MODEL_FAST=claude-sonnet-5
AI_MODEL_STRONG=claude-opus-5
# Alert threshold, EUR / month (checked against logged token usage)
AI_COST_CEILING_EUR=50

# --- Admin UI protection (STRONGLY recommended on a public deployment) ---
# When set, every admin page requires HTTP Basic auth: user "admin", this password.
ADMIN_PASSWORD=
# Public URL of this deployment, used for OAuth redirect URIs,
# e.g. https://tv3socialautopilot-production.up.railway.app
PUBLIC_BASE_URL=

# --- Meta app (enables the guided "Connect" flow in the admin UI) ---
# Create a Business-type app at developers.facebook.com owned by TV3's
# Business Manager; the same app can host the Threads API use case.
META_APP_ID=
META_APP_SECRET=
# For "Facebook Login for Business" apps: create a Configuration
# (FB Login for Business -> Configurations, permissions pages_show_list,
# pages_manage_posts, pages_read_engagement, business_management) and put
# its ID here. Leave empty to use classic scope-based login.
META_LOGIN_CONFIG_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- Platform credentials (alternative to the Connect flow; env is the
#     fallback when nothing is connected in the admin UI) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Analytics (Phase 3) ---
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Alerts ---
SLACK_WEBHOOK_URL=
