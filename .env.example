# --- Core ---
# true = full pipeline runs but nothing is posted to real platforms (Phase 1 default)
DRY_RUN=true
DATABASE_URL=sqlite:///data/autopilot.db
# For production: postgresql+psycopg2://autopilot:password@postgres:5432/autopilot
TZ=Europe/Riga

# --- AI decision layer ---
# If unset, the service still runs: a deterministic fallback scores and formats posts.
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_STRONG=claude-sonnet-5
# Alert threshold, EUR / month (checked against logged token usage)
AI_COST_CEILING_EUR=50

# --- Platform credentials (Phase 2; leave empty for dry run) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Analytics (Phase 3) ---
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Alerts ---
SLACK_WEBHOOK_URL=
